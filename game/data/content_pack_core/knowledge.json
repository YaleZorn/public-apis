      "explore_hook": "start_shield_small",
      "scenario": {
        "prompt": "弟子喊冷就想扛石锁。你怎么安排？",
        "choices": [
          {
            "text": "直接开练，节省时间",
            "correct": false
          },
          {
            "text": "先绕场慢跑/关节活动再加重",
